# ── DECOMERCE server ──────────────────────────────────────────────────────────
# This file holds real credentials and is git-ignored. Never commit it.

PORT=4000
NODE_ENV=development

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/decomerce?appName=Cluster0

# Absolute origin this API is reachable at. Blank = site-relative image URLs
# (fine when the storefront is served by this same server).
PUBLIC_BASE_URL=http://localhost:4000

# Signs the admin session token. Rotating it logs every admin out.
JWT_SECRET=generate-with-openssl-rand-hex-48
JWT_EXPIRES_IN=12h

# The single admin account. Change ADMIN_PASSWORD before you deploy, or set
# ADMIN_PASSWORD_HASH instead (npm run hash -- "your password") and drop the
# plaintext line entirely.
ADMIN_EMAIL=admin@decomerce.com
ADMIN_PASSWORD=change-me
ADMIN_PASSWORD_HASH=

# Browser origins allowed to call the API. Comma-separated, or * for any.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:4000

# Resolvers used for the Atlas SRV lookup. Leave blank to use the system's.
# Set it if the server exits with `querySrv EBADRESP` at boot.
DNS_SERVERS=

# ── Image storage ─────────────────────────────────────────────────────────────
# Leave these blank and photos are written to UPLOAD_DIR on local disk, which is
# what local development wants. Fill all three in and the server stores photos
# on Cloudinary instead — required on Vercel, which has no persistent disk.
# Find them on the Cloudinary dashboard under "Product Environment Credentials".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=decomerce/products

# Where product photos are written, relative to the server folder. Point this
# at a mounted volume if you deploy somewhere the disk is wiped on release.
UPLOAD_DIR=uploads

# Upload ceiling for a single product image, in megabytes.
MAX_UPLOAD_MB=5
